# =============================================================================
# doc-graph-agent — 환경 변수 템플릿
# =============================================================================
# 사용법:
#   1) cp .env.example .env
#   2) 아래 값들을 채운다 (실제 값은 .env 에만, .env.example 은 키 이름만)
#   3) .env 는 .gitignore 에 의해 절대 커밋되지 않는다 (확인 완료)
#
# 관련 이슈:
#   #7  W2 환경 부트스트랩 — 본 파일이 거기서 정식화된다
#   #8  Spike 검증 — 본 파일이 거기서 처음 사용된다
#   #2  Kimi API 키 발급 (P0 blocker)
#   #6  Opik Cloud 계정 (W2 사전 준비)
# =============================================================================


# -----------------------------------------------------------------------------
# Neo4j (Aura Free 사용)
# -----------------------------------------------------------------------------
# 가입 후 인스턴스 생성 시 한 번만 다운로드되는 .txt 파일에서 복사.
# Aura Free 인스턴스는 7일 미사용 시 auto-pause 되므로 발표 직전 점검 필수.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# 안전장치 (코드에서 강제 적용)
# 모든 read 쿼리에 LIMIT 100 강제, write 는 별도 함수로만 허용.
NEO4J_DEFAULT_LIMIT=100


# -----------------------------------------------------------------------------
# LLM (Kimi — OpenAI 호환 SDK 사용)
# -----------------------------------------------------------------------------
# 멘토 활동비로 발급받는 키. 3주차까지는 임시 배부 + expire (#5 참조).
# OpenAI SDK 호환이므로 base_url 만 갈아끼우면 동일 코드 사용 가능.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# Ablation 측정용 — VectorRAG (Full) 의 LLM 도 토글 가능하게 (#1 길 4)
# EVAL_LLM 값에 따라 Kimi/GPT 선택. doc-summary-agent#127 어댑터에서 사용.
EVAL_LLM=kimi
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# Opik (트레이싱 + 평가) — Comet Cloud
# -----------------------------------------------------------------------------
# https://www.comet.com/site/products/opik/ 에서 워크스페이스 생성 후 발급.
# OPIK_PROJECT_NAME 은 자유롭게 (예: doc-graph-agent).
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
OPIK_WORKSPACE=
OPIK_API_KEY=
OPIK_PROJECT_NAME=doc-graph-agent


# -----------------------------------------------------------------------------
# 임베딩 (Layer B retrieval, NED dedup)
# -----------------------------------------------------------------------------
# 기존 doc-summary-agent 와 동일하게 BGE-M3 사용 (재활용 자산).
# 로컬 sentence-transformers 또는 OpenAI 호환 endpoint 둘 다 지원 예정.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu


# -----------------------------------------------------------------------------
# 평가 셋
# -----------------------------------------------------------------------------
# 기존 레포에서 포팅. 수정 금지 (Before/After 비교 기준선).
EVAL_DATASET_PATH=eval/dataset/qa_pairs.json
EVAL_DOCS_PATH=eval/dataset/docs/


# -----------------------------------------------------------------------------
# 로깅
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
